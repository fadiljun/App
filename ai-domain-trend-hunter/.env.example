ANTHROPIC_API_KEY=sk-ant-...
DB_PATH=./trends.sqlite

# Porkbun API (for availability + pricing)
PORKBUN_API_KEY=pk1_...
PORKBUN_SECRET_KEY=sk1_...

# Scheduler
SCHEDULER_CRON=*/30 * * * *
EXTRACTOR_BATCH_SIZE=10
AVAILABILITY_BATCH_SIZE=25

# Approval-queue threshold (sum of 3 scores, out of 30)
BUY_MIN_SCORE=27
BUY_ALLOWED_TLDS=com,io

# Resale markup (listing price = buy price * this)
LISTING_MARKUP=10
