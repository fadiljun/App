# Either bundle a key directly (dev only — not recommended for production)
# EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...

# Or route through a proxy (recommended for production — Cloudflare Worker etc.)
EXPO_PUBLIC_CLAUDE_PROXY_URL=https://your-worker.workers.dev/eq

# RevenueCat (paywall) — required when shipping
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
